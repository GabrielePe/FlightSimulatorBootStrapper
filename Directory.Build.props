<Project>
  <PropertyGroup>
    <!-- ── Versione applicazione ─────────────────────────────────────
         Version        : versione SemVer leggibile a runtime via
                          Assembly.GetEntryAssembly()!.GetName().Version
                          o tramite informationalVersion.
         AssemblyVersion: usata dal runtime .NET per il binding.
                          Cambia solo il Major tra breaking changes.
         FileVersion    : mostrata in Esplora file → Proprietà → Dettagli.
    ─────────────────────────────────────────────────────────────── -->
    <Version>0.0.7</Version>
    <AssemblyVersion>0.0.7.0</AssemblyVersion>
    <FileVersion>0.0.7.0</FileVersion>

    <Company>Gabriele Perica</Company>
    <Product>Flight Simulator BootStrapper</Product>
    <Copyright>Copyright © Gabriele Perica 2026</Copyright>
  </PropertyGroup>
</Project>
