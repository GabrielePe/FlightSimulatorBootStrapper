<ui:FluentWindow
    x:Class="FsBootStrapper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:FsBootStrapper"
    xmlns:views="clr-namespace:FsBootStrapper.Views"
    mc:Ignorable="d"
    Title="FsBootStrapper"
    Height="680" Width="980"
    MinHeight="560" MinWidth="800"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="FsBootStrapper"
            ShowMaximize="True"
            ShowMinimize="True"/>

        <!-- Layout: nav sidebar + content frame -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation sidebar -->
            <ui:NavigationView
                x:Name="NavigationRoot"
                Grid.Column="0"
                PaneTitle="FSBS"
                IsPaneOpen="{Binding IsPaneOpen}"
                OpenPaneLength="200">

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem
                        Content="Dashboard"
                        Tag="{x:Type views:DashboardPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        Content="Profiles"
                        Tag="{x:Type views:ProfileEditorPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DocumentBulletList24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        Content="Launch Monitor"
                        Tag="{x:Type views:LaunchMonitorPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Play24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem
                        Content="Settings"
                        Tag="{x:Type views:SettingsPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- Page content frame -->
            <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
