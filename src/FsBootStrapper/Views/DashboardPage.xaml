<Page
    x:Class="FsBootStrapper.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FsBootStrapper.ViewModels"
    Title="Dashboard"
    d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
    mc:Ignorable="d">

    <Grid MaxWidth="1024" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <!--  Header  -->
            <TextBlock
                Margin="0,0,0,20"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Dashboard" />

            <!--  MSFS Status Card  -->
            <ui:Card Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="MSFS 2024 Installation" />
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            FontSize="24"
                            Symbol="Airplane24" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding MsfsInstallation.Type, FallbackValue='Not detected'}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding MsfsInstallation.ExecutablePath, FallbackValue='â€”'}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--  Profile Selection Card  -->
            <ui:Card Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Active Profile" />
                    <ComboBox
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding AvailableProfiles}"
                        SelectedItem="{Binding SelectedProfile}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding SelectedProfile.Description, FallbackValue=''}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!--  Launch Controls  -->
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Padding="24,10"
                    HorizontalAlignment="Left"
                    Appearance="Primary"
                    Click="OnLaunchClicked"
                    Content="Launch"
                    Icon="{ui:SymbolIcon Play24}"
                    IsEnabled="{Binding IsLaunching, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                <ui:Button
                    Padding="16,10"
                    Appearance="Danger"
                    Click="OnStopAllClicked"
                    Content="Stop All"
                    Icon="{ui:SymbolIcon Stop24}" />
            </StackPanel>

            <!--  Status  -->
            <TextBlock
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusMessage}" />
        </StackPanel>

        <!--  Progress list  -->
        <StackPanel Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LaunchProgress}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Width="60"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                                    <TextBlock
                                        Width="140"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding EventType}" />
                                    <TextBlock
                                        FontSize="12"
                                        Text="{Binding Message}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
