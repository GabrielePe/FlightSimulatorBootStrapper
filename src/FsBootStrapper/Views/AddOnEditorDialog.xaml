<ui:FluentWindow
    x:Class="FsBootStrapper.Views.AddOnEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FsBootStrapper.ViewModels"
    xmlns:models="clr-namespace:FsBootStrapper.Core.Models;assembly=FsBootStrapper.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance vm:AddOnEditorViewModel}"
    mc:Ignorable="d"
    Title="Add-on Configuration"
    Width="540"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HideWhenTrue" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AutoCloseSupported}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AutoCloseSupported}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Add-on Configuration" ShowMinimize="False" ShowMaximize="False"/>

        <Grid Grid.Row="1" Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Section: Identity ─────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Identity" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

            <TextBlock Text="Display name *" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtDisplayName"
                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Executable *" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"/>
                <ui:Button Grid.Column="2"
                           Content="Browse…"
                           Command="{Binding BrowseExecutableCommand}"
                           Padding="12,6"/>
            </Grid>

            <TextBlock Text="Arguments (optional)" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Privileges" Margin="0,10,0,4"/>
            <CheckBox Content="Requires administrator privileges (UAC elevation)"
                      IsChecked="{Binding RequiresElevation}"
                      ToolTip="Enable if this add-on shows a UAC prompt when launched manually. FSBS will launch it with the elevated token it already holds, skipping the prompt. Leave unchecked (default) for add-ons like TrackIR that must run at normal user level to communicate with MSFS."/>
        </StackPanel>

        <!-- ── Section: Launch order ─────────────────────────────── -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Launch order" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Phase" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Phases}"
                              SelectedItem="{Binding Phase}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Delay before launch (s)" Margin="0,0,0,4"/>
                    <ui:NumberBox Value="{Binding DelaySeconds}"
                                  Minimum="0" Maximum="3600"
                                  SmallChange="1" LargeChange="10"
                                  ClearButtonEnabled="False"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Delay after launch (s)" Margin="0,0,0,4"/>
                    <ui:NumberBox Value="{Binding DelayAfterSeconds}"
                                  Minimum="0" Maximum="3600"
                                  SmallChange="1" LargeChange="10"
                                  ClearButtonEnabled="False"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ── Section: Wait for process ─────────────────────────── -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Wait for process" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

            <CheckBox Content="Wait for a specific process to be running before launching"
                      IsChecked="{Binding WaitForProcessEnabled}"
                      Margin="0,0,0,10"/>

            <Grid Visibility="{Binding WaitForProcessEnabled, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Process name (without .exe)" Margin="0,0,0,4"/>
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding KnownProcessNames}"
                              Text="{Binding WaitProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Timeout (s, -1 = ∞)" Margin="0,0,0,4"/>
                    <ui:NumberBox Value="{Binding WaitTimeoutSeconds}"
                                  Minimum="-1" Maximum="3600"
                                  SmallChange="5"
                                  ClearButtonEnabled="False"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ── Section: Shutdown ─────────────────────────────────── -->
        <StackPanel Grid.Row="3" Margin="0,0,0,24">
            <TextBlock Text="Shutdown" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

            <CheckBox Content="Add-on handles its own shutdown (auto-close)"
                      IsChecked="{Binding AutoCloseSupported}"
                      Margin="0,0,0,10"/>

            <StackPanel Style="{StaticResource HideWhenTrue}">
                <TextBlock Text="Close method when MSFS exits" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding CloseMethods}"
                          SelectedItem="{Binding CloseMethod}"
                          HorizontalAlignment="Left" MinWidth="180"
                          Margin="0,0,0,14"/>

                <CheckBox Content="Specify the process to close on MSFS exit"
                          IsChecked="{Binding ShutdownByProcessNameEnabled}"
                          ToolTip="Enable if ExecutablePath starts an updater that then spawns the real application under a different process. FSBS will look up the process below when MSFS exits, instead of relying on the (likely already-exited) launcher's PID."
                          Margin="0,0,0,10"/>

                <Grid Visibility="{Binding ShutdownByProcessNameEnabled, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Process name to close (without .exe)" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ShutdownProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Match mode" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ProcessMatchModes}"
                                  SelectedItem="{Binding ShutdownProcessMatchMode}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="⚠ Keyword mode closes EVERY running process whose name contains this text — not just this add-on's. Use an exact, specific name unless you are certain it's safe."
                           Visibility="{Binding ShutdownByProcessNameEnabled, Converter={StaticResource BoolToVis}}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Divider ────────────────────────────────────────────── -->
        <Separator Grid.Row="4" Margin="0,0,0,16"/>

        <!-- ── Required notice ───────────────────────────────────── -->
        <TextBlock Grid.Row="5"
                   Text="* Required fields"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   FontSize="11"
                   Margin="0,0,0,12"/>

        <!-- ── OK / Cancel ───────────────────────────────────────── -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel"
                       IsCancel="True"
                       Click="OnCancelClicked"
                       Padding="20,8"
                       Margin="0,0,12,0"/>
            <ui:Button x:Name="BtnOk"
                       Content="OK"
                       Appearance="Primary"
                       IsDefault="True"
                       Click="OnOkClicked"
                       Padding="20,8"/>
        </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
