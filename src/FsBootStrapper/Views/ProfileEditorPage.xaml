<Page
    x:Class="FsBootStrapper.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FsBootStrapper.ViewModels"
    xmlns:local="clr-namespace:FsBootStrapper.Views"
    xmlns:models="clr-namespace:FsBootStrapper.Core.Models;assembly=FsBootStrapper.Core"
    d:DataContext="{d:DesignInstance vm:ProfileEditorViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Profiles">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:NullToBoolConverter x:Key="NullToBool"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Profile list (left panel) ────────────────────────── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Profiles"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8"/>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     DisplayMemberPath="Name"
                     BorderThickness="0"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="New"
                           Icon="{ui:SymbolIcon Add24}"
                           Click="OnNewProfileClicked"
                           Padding="12,6"
                           Margin="0,0,8,0"/>
                <ui:Button Content="Delete"
                           Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Danger"
                           Click="OnDeleteProfileClicked"
                           Padding="12,6"/>
            </StackPanel>
        </Grid>

        <!-- ── Divider ───────────────────────────────────────────── -->
        <Rectangle Grid.Column="1"
                   Width="1"
                   Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                   HorizontalAlignment="Center"/>

        <!-- ── Profile detail (right panel) ─────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Profile meta -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Profile Name" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"/>
                <TextBlock Text="Description (optional)" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ProfileDescription, UpdateSourceTrigger=PropertyChanged}"
                         Height="56" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <!-- Add-on list header -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Add-ons"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <ui:Button Grid.Column="1"
                           Content="Add add-on…"
                           Icon="{ui:SymbolIcon Add24}"
                           Click="OnAddItemClicked"
                           Padding="12,6"
                           IsEnabled="{Binding SelectedProfile, Converter={StaticResource NullToBool}}"/>
                <ui:Button Grid.Column="3"
                           Content="Import exe.xml…"
                           Icon="{ui:SymbolIcon ArrowImport24}"
                           Click="OnImportExeXmlClicked"
                           Padding="12,6"
                           ToolTip="Import add-ons from an MSFS exe.xml file"
                           IsEnabled="{Binding SelectedProfile, Converter={StaticResource NullToBool}}"/>
            </Grid>

            <!-- Add-on DataGrid -->
            <DataGrid Grid.Row="2"
                      x:Name="ItemsGrid"
                      ItemsSource="{Binding SelectedProfile.Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <!-- Phase indicator -->
                    <DataGridTemplateColumn Header="Phase" Width="Auto" SortMemberPath="Phase">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Phase}"
                                           Padding="6,4"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Display name -->
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding DisplayName}"
                                        Width="Auto"/>

                    <!-- Executable (filename only) -->
                    <DataGridTemplateColumn Header="Executable" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExecutablePath}"
                                           Padding="6,4"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ExecutablePath}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Delay -->
                    <DataGridTemplateColumn Header="Delay" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Padding="6,4" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="—"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DelayBeforeLaunchMs}" Value="0">
                                                    <Setter Property="Text" Value="—"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Wait For -->
                    <DataGridTemplateColumn Header="Wait for" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Padding="6,4" VerticalAlignment="Center"
                                           Text="{Binding WaitForProcess.ProcessName, FallbackValue='—', TargetNullValue='—'}"
                                           ToolTip="{Binding WaitForProcess.ProcessName}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Auto-close badge -->
                    <DataGridTemplateColumn Header="Force closing" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Padding="6,4" VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✓"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AutoCloseSupported}" Value="True">
                                                    <Setter Property="Text" Value="✗"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                               Padding="5"
                                               Margin="0,0,2,0"
                                               ToolTip="Edit"
                                               Tag="{Binding}"
                                               Click="OnEditItemClicked"/>
                                    <ui:Button Icon="{ui:SymbolIcon ArrowUp24}"
                                               Padding="5"
                                               Margin="0,0,2,0"
                                               ToolTip="Move up"
                                               Command="{Binding DataContext.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                    <ui:Button Icon="{ui:SymbolIcon ArrowDown24}"
                                               Padding="5"
                                               Margin="0,0,2,0"
                                               ToolTip="Move down"
                                               Command="{Binding DataContext.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                    <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                               Padding="5"
                                               Appearance="Danger"
                                               ToolTip="Remove"
                                               Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Save bar -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0"
                           Content="Save Profile"
                           Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary"
                           Click="OnSaveProfileClicked"
                           Padding="20,8"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
