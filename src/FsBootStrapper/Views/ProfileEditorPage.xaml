<Page
    x:Class="FsBootStrapper.Views.ProfileEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:FsBootStrapper.ViewModels"
    xmlns:models="clr-namespace:FsBootStrapper.Core.Models;assembly=FsBootStrapper.Core"
    d:DataContext="{d:DesignInstance vm:ProfileEditorViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Profiles">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Profile list (left panel) -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Profiles" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     DisplayMemberPath="Name"
                     BorderThickness="0"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="New" Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding NewProfileCommand}" Padding="12,6"/>
                <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Danger"
                           Command="{Binding DeleteProfileAsyncCommand}" Padding="12,6"/>
            </StackPanel>
        </Grid>

        <!-- Divider -->
        <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                   LayoutTransform="{StaticResource {x:Static FlowDirection.LeftToRight}}"/>

        <!-- Profile detail (right panel) -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Profile name/description -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Profile Name" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"/>
                <TextBlock Text="Description (optional)" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SelectedProfile.Description, UpdateSourceTrigger=PropertyChanged}"
                         Height="56" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <!-- Add-on list toolbar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Add-ons" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                <ui:Button Content="Add" Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding AddItemCommand}" Padding="12,6"/>
            </StackPanel>

            <!-- Add-on items -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding SelectedProfile.Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      x:Name="ItemsGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="160"/>
                    <DataGridTextColumn Header="Executable" Binding="{Binding ExecutablePath}" Width="*"/>
                    <DataGridComboBoxColumn Header="Phase"
                                           SelectedItemBinding="{Binding Phase}"
                                           Width="110"/>
                    <DataGridTextColumn Header="Delay (ms)" Binding="{Binding DelayBeforeLaunchMs}" Width="90"/>
                    <DataGridCheckBoxColumn Header="Auto-close" Binding="{Binding AutoCloseSupported}" Width="85"/>
                    <DataGridTemplateColumn Header="Actions" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Padding="4"
                                               Command="{Binding DataContext.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                    <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Padding="4"
                                               Command="{Binding DataContext.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Padding="4"
                                               Appearance="Danger"
                                               Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Save bar -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Save Profile"
                           Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary"
                           Command="{Binding SaveProfileAsyncCommand}"
                           Padding="20,8"/>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

